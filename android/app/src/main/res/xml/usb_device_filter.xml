<?xml version="1.0" encoding="utf-8"?>
<!--
    Match any USB HID device (class 3).
    We don't filter by VID/PID here — that caused devices with slightly
    different enumeration to be silently ignored. Instead, MainActivity
    identifies Grünstahl by VID/PID after the user selects it, or
    auto-connects if only one HID device is present.
-->
<resources>
    <usb-device class="3" />
</resources>
